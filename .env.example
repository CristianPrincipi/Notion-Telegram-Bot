# David — environment variables.
#
# Copy to `.env` for a local run (`.env` is gitignored), fill in the required
# block, then start David with:
#
#     dotenv run -- python david.py
#
# On Railway, set the same names as service Variables instead; no file needed.
# Every variable is explained in docs/configuration.md.
#
# A blank value counts as unset, so an optional line left as `NAME=` is safe.
# Keeping unused ones commented out is just tidier.

# ─── REQUIRED ─────────────────────────────────────────────────────────────────

# Telegram — docs/setup.md § 2
TELEGRAM_TOKEN=
OWNER_ID=
CHAT_ID=

# Notion — docs/setup.md § 3
NOTION_KEY=
EXPENSES_ID=
LETTI_ID=
LITERATURE_ID=
LEARN_ID=

# Anthropic — docs/setup.md § 5
ANTHROPIC_API_KEY=

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# Google Calendar — docs/setup.md § 4. Paste the whole service-account JSON on
# one line, in single quotes. Set GOOGLE_CALENDAR_ID whenever you set the key:
# the default, `primary`, is the service account's own calendar, not yours.
# GOOGLE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", ...}'
# GOOGLE_CALENDAR_ID=you@gmail.com

# YouTube transcripts for `Learn video`.
# SUPADATA_KEY=

# Areas for `Implement` and `Get` — one {AREA}_ID per area.
# BRAIN_ID=
# FINANCE_ID=
# DIET_ID=

# Budget — monthly ceiling in euros (default 300).
# BUDGET_CEILING=300

# Month pages — both are normally unnecessary; see docs/configuration.md.
# MONTHS_DB_ID=
# MONTH_ID=

# Anthropic limits.
# ANTHROPIC_MAX_TOKENS=8192
# ANTHROPIC_DAILY_BUDGET_USD=5
# ANTHROPIC_SPEND_FILE=.anthropic_spend.json

# Logging: DEBUG, INFO, WARNING, ERROR or CRITICAL (default INFO).
# LOG_LEVEL=INFO
